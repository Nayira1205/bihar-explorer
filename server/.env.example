# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (or a local mongodb://127.0.0.1:27017/bihar-explorer)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bihar-explorer

# Port the API listens on
PORT=5000

# development | production
NODE_ENV=development

# Origin allowed to call this API with credentials (your Vite dev server)
CLIENT_URL=http://localhost:5173

# JWT signing secret — any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Created automatically the first time you run `npm run seed`, if no
# account with this email already exists. Change these before deploying
# anywhere public — the defaults are not secret.
ADMIN_EMAIL=admin@biharexplorer.local
ADMIN_PASSWORD=ChangeMe123
